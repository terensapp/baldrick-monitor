{
  "listen": ":8420",
  "temperature_unit": "F",
  "boards": [
    {
      "name": "pixel1",
      "host": "192.168.6.4"
    }
  ],
  "intervals": {
    "icmp": "1s",
    "http_ping": "5s",
    "system_state": "15s",
    "web_ui": "1m",
    "settings": "5m",
    "ddp_probe": "1m",
    "fpp": "15s"
  },
  "ddp_probe": {
    "mode": "auto",
    "offset": 1000000,
    "packets": 60,
    "rate": 20
  },
  "history": {
    "retention_days": 7,
    "resolution": "1m",
    "data_dir": "/var/lib/baldrick-monitor"
  },
  "thresholds": {
    "http_fail_down": 3,
    "icmp_loss_warn": 0.05,
    "rtt_warn_ms": 50,
    "ddp_loss_warn": 0.01,
    "temp_warn_c": 70,
    "ram_min_warn_bytes": 48000
  },
  "incidents": {
    "retention_days": 90,
    "recorder_window": "30m"
  },
  "alerts": {
    "webhook_url": "",
    "format": "json",
    "dashboard_url": ""
  },
  "updates": {
    "check_interval": "6h"
  }
}
